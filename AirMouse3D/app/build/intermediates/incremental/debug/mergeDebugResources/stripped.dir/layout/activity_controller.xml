<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".ControllerActivity">

    <!-- Status bar (UI-6) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="@color/bg_surface"
        android:text="Connecting…"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ROTATE — large, center top (Section 9.3) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRotate"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:text="⟳  ORBIT\n(hold)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/btn_rotate_text"
        android:backgroundTint="@color/btn_rotate_bg"
        app:cornerRadius="14dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LEFT / RIGHT row -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLeft"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="◀  LEFT"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/btn_primary_text"
        android:backgroundTint="@color/btn_primary_bg"
        app:cornerRadius="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnRotate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnRight"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRight"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="RIGHT  ▶"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/btn_primary_text"
        android:backgroundTint="@color/btn_primary_bg"
        app:cornerRadius="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnRotate"
        app:layout_constraintStart_toEndOf="@id/btnLeft"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ZOOM IN / ZOOM OUT row -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZoomIn"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="🔍  ZOOM +"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/btn_zoom_text"
        android:backgroundTint="@color/btn_zoom_bg"
        app:cornerRadius="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnZoomOut"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZoomOut"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="🔍  ZOOM -"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/btn_zoom_text"
        android:backgroundTint="@color/btn_zoom_bg"
        app:cornerRadius="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnRight"
        app:layout_constraintStart_toEndOf="@id/btnZoomIn"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CALIBRATE -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalibrate"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="⊙  CALIBRATE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/btn_recenter_bg"
        android:textColor="@color/btn_recenter_text"
        app:cornerRadius="14dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnZoomIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- REAL-TIME SENSOR DATA HUD WINDOW -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSensorData"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:strokeColor="#252D3D"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnCalibrate"
        app:layout_constraintBottom_toTopOf="@id/btnDisconnect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical">

            <!-- Title & Live status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/viewLiveDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/live_dot"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE SENSOR DATA"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvSensorRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 Hz"
                    android:textColor="@color/btn_zoom_text"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Orientation / Euler Angles -->
            <TextView
                android:id="@+id/tvSensorAngles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YAW: +0.0°   PITCH: +0.0°   ROLL: +0.0°"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp"/>

            <!-- Gyroscope -->
            <TextView
                android:id="@+id/tvSensorGyro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GYRO (rad/s) : gx:+0.00 gy:+0.00 gz:+0.00"
                android:textColor="@color/btn_rotate_text"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp"/>

            <!-- Linear Accel -->
            <TextView
                android:id="@+id/tvSensorAccel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCEL(m/s²)  : ax:+0.00 ay:+0.00 az:+0.00"
                android:textColor="@color/btn_recenter_text"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp"/>

            <!-- Delta (protocol output) -->
            <TextView
                android:id="@+id/tvSensorQuat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DELTA  dx:+0.000  dy:+0.000  dz:+0.000"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:fontFamily="monospace"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- DISCONNECT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Disconnect"
        android:textSize="13sp"
        android:backgroundTint="@color/btn_disconnect_bg"
        android:textColor="@color/text_secondary"
        app:cornerRadius="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
